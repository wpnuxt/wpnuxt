{
  "name": "@wpnuxt/core",
  "version": "2.5.0",
  "description": "Nuxt module for WordPress integration via GraphQL (WPGraphQL)",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "wordpress",
    "graphql",
    "wpgraphql",
    "headless-cms",
    "headless-wordpress",
    "vue",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wpnuxt/wpnuxt.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./server-options": {
      "types": "./dist/server-options.d.mts",
      "import": "./dist/server-options.mjs",
      "default": "./dist/server-options.mjs"
    },
    "./client-options": {
      "types": "./dist/client-options.d.mts",
      "import": "./dist/client-options.mjs",
      "default": "./dist/client-options.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist",
    "server",
    "app"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.7.0",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "dompurify": "^3.5.0",
    "graphql": "^16.14.2",
    "nuxt-graphql-middleware": "5.5.1",
    "scule": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "4.2.2",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.7.0",
    "@nuxt/test-utils": "^4.4.0",
    "@types/node": "^26.6.11",
    "nuxt": "^4.7.0",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "nuxt": "^4.4.0"
  }
}
